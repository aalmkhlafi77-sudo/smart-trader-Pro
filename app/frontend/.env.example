# Smart Trader private MySQL storage (server-side only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_trader_private
MYSQL_USER=smart_trader_user
MYSQL_PASSWORD=change-me

# Bootstrap only: used to create the first private account if it does not exist.
# Keep these values only in Hostinger environment variables. Never commit real secrets.
PRIVATE_ADMIN_USERNAME=admin
PRIVATE_ADMIN_PASSWORD=change-this-to-a-long-random-password
